<file path="src/features/pomodoro/dashboard-ui.js">
export function initPomodoroDashboard() {
    const uploadInput = document.getElementById('pomoCharUpload');
    const sizeSlider = document.getElementById('pomoSizeSlider');
    const textInput = document.getElementById('pomoDefaultText');
    const previewImg = document.getElementById('pomoPreviewImg');
    const previewText = document.getElementById('pomoPreviewText');
    const saveBtn = document.getElementById('savePomoBtn');

    if (!uploadInput || !saveBtn) return;

    let currentBase64 = null;

    // Sinkronisasi Live Preview Teks
    const updateLivePreview = () => {
        const text = textInput.value || "mangat2";
        previewText.innerHTML = `${text}<br>kurang 25:00`;
        previewImg.style.width = `${sizeSlider.value}px`;
    };

    textInput.addEventListener('input', updateLivePreview);
    sizeSlider.addEventListener('input', updateLivePreview);

    // Handler Upload Gambar
    uploadInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = () => {
            currentBase64 = reader.result;
            previewImg.src = currentBase64;
            previewImg.style.display = "block"; // Pastikan muncul
            console.log("Gambar berhasil dikonversi ke Base64");
        };
        reader.onerror = () => {
            alert("Gagal membaca file gambar.");
        };
        reader.readAsDataURL(file);
    });

    // Load Data dari Storage
    chrome.storage.local.get(['pomoImage', 'pomoSize', 'pomoDefaultText'], (data) => {
        if (data.pomoImage) {
            currentBase64 = data.pomoImage;
            previewImg.src = data.pomoImage;
        }
        if (data.pomoSize) sizeSlider.value = data.pomoSize;
        if (data.pomoDefaultText) textInput.value = data.pomoDefaultText;
        updateLivePreview();
    });

    // Handler Simpan
    saveBtn.addEventListener('click', async () => {
        const settings = {
            pomoSize: parseInt(sizeSlider.value),
            pomoDefaultText: textInput.value || "mangat2",
            pomoText: textInput.value || "mangat2"
        };

        if (currentBase64) {
            settings.pomoImage = currentBase64;
        }

        await chrome.storage.local.set(settings);
        alert("✅ Pengaturan berhasil disimpan!");
    });
}
