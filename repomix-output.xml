<html>
  <head>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        width: 250px;
        padding: 16px;
        color: #333;
      }
      .row {
        margin-bottom: 16px;
      }
      label {
        display: block;
        font-size: 13px;
        margin-bottom: 6px;
        font-weight: 500;
      }
      .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
