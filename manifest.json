{
    "manifest_version": 3,
    "name": "Mode Fokus",
    "version": "1.0",
    "description": "Meningkatkan produktivitas dengan membatasi jumlah tab dan memblokir situs web pengganggu.",
    "permissions": [
        "tabs",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "icons": {
        "16": "assets/icon-16.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon-16.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}