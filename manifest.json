{
    "manifest_version": 3,
    "name": "Fokus & Clipboard",
    "version": "2.1.0",
    "description": "Membatasi tab, memblokir distraksi, mengekstrak artikel, dan manajemen snippet.",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "contextMenus",
        "clipboardRead",
        "alarms",
        "downloads"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "icons": {
        "16": "assets/icon-16.png"
    },
    "action": {
        "default_popup": "src/entrypoints/popup/index.html",
        "default_icon": {
            "16": "assets/icon-16.png"
        }
    },
    "background": {
        "service_worker": "src/entrypoints/background/index.js",
        "type": "module"
    },
    "options_page": "src/entrypoints/options/index.html"
}