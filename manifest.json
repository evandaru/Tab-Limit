{
    "manifest_version": 3,
    "name": "Fokus & Clipboard",
    "version": "2.0.0",
    "description": "Membatasi tab, memblokir distraksi, mengekstrak artikel, dan menyimpan kutipan clipboard.",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "contextMenus"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "icons": {
        "16": "assets/icon-16.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon-16.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "options_page": "options/options.html"
}