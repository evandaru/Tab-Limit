{
    // ============================================================
    // DISABLED COPY - new tab override is currently turned OFF.
    //
    // This is a reference copy of manifest.json with the new tab
    // override included. It is NOT loaded by Chrome; only
    // manifest.json is.
    //
    // To turn the Tab Focus new tab override back on:
    //   1. copy the "chrome_url_overrides" block below into manifest.json
    //      (right after "action"),
    //   2. uncomment the archived code at the bottom of
    //      src/features/tab-focus/settings.js and
    //      src/entrypoints/newtab/index.js,
    //   3. reload the extension at chrome://extensions.
    //
    // Turning it off again = remove that block from manifest.json.
    // ============================================================
    "manifest_version": 3,
    "name": "Focus & Clipboard",
    "version": "2.1.0",
    "description": "Limits tabs, blocks distractions, extracts articles, and manages snippets.",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "contextMenus",
        "clipboardRead",
        "alarms",
        "downloads",
        "notifications",
        "unlimitedStorage",
        "bookmarks",
        "topSites",
        "idle"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "icons": {
        "16": "assets/icon-16.png"
    },
    "action": {
        "default_popup": "src/entrypoints/popup/index.html",
        "default_icon": {
            "16": "assets/icon-16.png"
        }
    },
    "chrome_url_overrides": {
        "newtab": "src/entrypoints/newtab/index.html"
    },
    "background": {
        "service_worker": "src/entrypoints/background/index.js",
        "type": "module"
    },
    "options_page": "src/entrypoints/options/index.html",
    "web_accessible_resources": [
        {
            "resources": [
                "assets/chat.png",
                "assets/icon-16.png",
                "assets/kucing.gif"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
